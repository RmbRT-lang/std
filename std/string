(/rl/)

INCLUDE 'std/memory'

INCLUDE 'std/str'
INCLUDE 'std/heap'

/// Dynamic container for an std::str::View.
::std [Alloc] String -> PRIVATE Alloc
{
	PRIVATE Content: CHAR[#];

	{};
	{BARE} ();

	{data: CHAR#[#]} --: Content(Alloc::clone(data));
	:cstring{data: CHAR#[#]}: Content(Alloc::[CHAR]alloc_array(##data+1))
	{
		range::[CHAR]copy_construct(Content[], data[], ##data);
		Content[##data] := 0;
		##Content := ##data;
	}
	:transfer{data: CHAR#[#]}: Content := data;

	{#&cpy} -> (cpy):
		Content(->(Alloc).clone(cpy.Content));
	{&&mv}:
		Content(mv.Content)
	{
		mv.Content := NULL;
	}
	DESTRUCTOR
	{
		IF(Content[])
			heap::alloc.free_array(<CHAR#[#]>(Content));
		Content := NULL;
	}

	# THIS <> (rhs: THIS#&) S1 := str::order(THIS!, rhs!);

	# data() ? -- := Content[];
	# ##THIS ? -- := ##Content;
	# THIS[i: Index] ?#& -- := Content[i(##Content)];
	#? THIS! CHAR#?[#] -- := Content;

	[T...: TYPE]
	append(v: T!&&...) VOID --
	{
		sz: UM := ##THIS;
		(sz += ##<CHAR#[#]>(v))...;

		new ::= Alloc::[CHAR]alloc_array(sz);
		start ::= new[];
		start += range::copy_construct(start, Content[], ##Content);
		(start += range::copy_construct(start, <CHAR#[#]>(v)[], ##<CHAR#[#]>(v)))...;
		THIS := :transfer(new);
	}

	THIS+=(str: CHAR#[#]) VOID --
	{ append(str); }
}

::std TYPE Str := [heap::Alloc]String;