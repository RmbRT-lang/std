(/rl/)

INCLUDE 'std/error'
INCLUDE 'std/err/indexoutofrange'

::std Index
{
	Checked: BOOL;
	I: U4;

	{}--;

	{i: U4} --:
		I := i;

	:ok {i: U4} --:
		Checked := TRUE,
		I := i;

	:nok {i: U4} --:
		I := i;

	:opt {i: U4} --:
		I := i;

	:allow{i: U4} --:
		Checked := TRUE,
		I := i;

	# THIS(range: U4) U4 --
	{
		IF(Checked || I < range)
			= I;
		THROW <err::IndexOutOfRange>(range, I);
	}


	# THIS[range: U4] U4 --
	{
		IF(Checked || I <= range)
			= I;
		THROW <err::IndexOutOfRange>(range+1, I);
	}
}