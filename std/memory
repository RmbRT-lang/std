(/rl/)

INCLUDE 'std/range'
INCLUDE 'std/math/limit'

::std
{
	::mem [T] eq(lhs: T!#[], rhs: T!#[], count: UM) BOOL --
	{
		FOR(count)
			IF(lhs[IOTA] != rhs[IOTA])
				= FALSE;
		= TRUE;
	}

	::mem [T] cmp(
		lhs: T! #[],
		rhs: T! #[],
		elements: UM) S1
	{
		FOR(elements)
			IF(s ::= lhs[IOTA] <> rhs[IOTA])
				= s;
		= 0;
	}

	::mem [T] cmp_array(
		lhs: T![#],
		rhs: T![#]) S1
	{
		IF(s ::= ##lhs <> ##rhs)
			= s;
		= mem::cmp(lhs.Data, rhs.Data, ##lhs);
	}

	::mem cpy(dst: VOID \, src: VOID #\, size: UM) VOID --
	{
		d ::= <U1 \>(dst);
		s ::= <U1 #\>(src);
		WHILE(size--)
			*d++ := *s++;
	}

	/// Simple non-null reference type with value-comparison behaviour.
	[T] Ref
	{
		V: T! \;
		{...}--;

		{BARE} { DIE; }

		# <T! &> -- := *V;
		# *THIS T!& -- := *V;
		# THIS! T!& -- := *V;
		# THIS() T!& -- := *V;
		# |THIS T! \ -- := V;

		# THIS <>(rhs: THIS) S1 -- := *V <> *rhs;
	}

	[T] OptRef
	{
		V: T! *;
		{...}--;

		# ptr() T! * -- := V;
		# <T! *> -- := V;
		# *THIS T!& -- := *V;
		# THIS! T!& -- := *V;
		# THIS() T!& -- := *V;
	}
}