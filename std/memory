(/rl/)

::std
{
	::mem [T] eq(lhs: T!#[], rhs: T!#[], count: UM) BOOL --
	{
		FOR(count)
			IF(lhs[IOTA] != rhs[IOTA])
				= FALSE;
		= TRUE;
	}

	::mem [T] cmp(
		lhs: T! #[],
		rhs: T! #[],
		elements: UM) S1
	{
		FOR(elements)
			IF(s ::= lhs[IOTA] <> rhs[IOTA])
				= s;
		= 0;
	}

	::mem [T]zero_array(arr: T![#]) VOID -- { set(arr, 0, SIZEOF(T) * ##arr); }
	::mem set(p: VOID *, v: U1, size: UM) VOID --
	{
		__builtin_memset(p, v, size);
		RETURN;
		v8: U8 := v * 0x0101010101010101;
		FOR(size>>5)
		{
			<U8 *>(p)[4*IOTA]   := v8;
			<U8 *>(p)[4*IOTA+1] := v8;
			<U8 *>(p)[4*IOTA+2] := v8;
			<U8 *>(p)[4*IOTA+3] := v8;
		}
		FOR(<U1 *>(p)[FROM size & ~<UM>(31) UNTIL size]) IT := v;
	}

	::mem [T] cmp_array(
		lhs: T![#],
		rhs: T![#]) S1
	{
		IF(s ::= ##lhs <> ##rhs)
			= s;
		= mem::cmp(lhs.Data, rhs.Data, ##lhs);
	}

	::mem cpy(dst: VOID \, src: VOID #\, size: UM) VOID --
	{
		__builtin_memcpy(dst, src, size);
		RETURN;
		d ::= <U1 \>(dst);
		s ::= <U1 #\>(src);
		WHILE(size--)
			*d++ := *s++;
	}

	::mem [T] cpy_array(dst: T![], src: T!#[], size: UM) VOID --
	{
		__builtin_memcpy(dst, src, size * SIZEOF(T));
	}

	/// Simple non-null reference type with value-comparison behaviour.
	[T] Ref
	{
		V: T! \;
		{...}--;

		{BARE} { DIE; }

		# <T! &> -- := *V;
		# *THIS T!& -- := *V;
		# THIS! T!& -- := *V;
		# THIS() T!& -- := *V;
		//# |THIS T! \ -- := V;

		# THIS <>(rhs: THIS) S1 -- := *V <> *rhs;
	}

	[T] OptRef
	{
		V: T! *;
		{...}--;

		# ptr() T! * -- := V;
		# <T! *> -- := V;
		# *THIS T!& -- := *V;
		# THIS! T!& -- := *V;
		# THIS() T!& -- := *V;
	}
}