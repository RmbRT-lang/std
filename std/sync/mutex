(/rl/)

INCLUDE 'std/tags'
INCLUDE 'std/math/limit'

::std::sync Mutex
{
	PRIVATE Locked: BOOL.;

	{}: Locked(FALSE);

	Handle
	{
		PRIVATE M: BOOL. *;
		DESTRUCTOR
		{
			IF(M)
			{
				*M := :>(FALSE);
				M := NULL;
			}
		}

		{}: M(NULL);
		{m: BOOL. \}: M(m);
		{&&v}: M(v.M) { v.{}; }
	}

	lock(:ok) VOID
	{
		WHILE(Locked :=: :<>(TRUE))
		{
			FOR(i ::= 1; Locked(:?);)
			{
				PAUSE;
				IF(i < 50) ++i;
				IF(i > 25)
					...500*KILO * (i-25);
			}
		}
	}
	THIS() Handle --
	{
		lock(:ok);
		= <Handle>(&Locked);
	}

	try_lock(:ok) BOOL -- := !Locked(:<>(TRUE));
	unlock(:ok) VOID -- { Locked := :>(FALSE); }
}