(/rl/)
INCLUDE "padding"
INCLUDE "bigint"

::std::crypto::rsa
{
	[#Words] TRsaPub {
		N: [#Words]BigInt;
		E: U4;
		Accel: [#2*Words; #Words]TModuloAccel;

		# encrypt(padded_msg: [#Words]BigInt #&, cipher: [#Words]BigInt \) VOID --
			{ padded_msg.pow_mod_fast_into(<[#Words]BigInt>(E), N, Accel, cipher); }
	}
	[#Bits] TYPE RsaPub := [#(Bits+31)/32]TRsaPub;

	[#Words] TRsaPriv {
		D: [#Words]BigInt;

		# decrypt(
			pub: [#Words]TRsaPub #&,
			ciphertext: [#Words]BigInt #&,
			padded_msg: [#Words]BigInt \
		) VOID -- { ciphertext.pow_mod_fast_into(D, pub.N, pub.Accel, padded_msg); }
	}
	[#Bits] TYPE RsaPriv := [#(Bits+31)/32]TRsaPriv;

	[#Words] rsa_keygen(
		pub: [#Words]TRsaPub \, priv: [#Words]TRsaPriv \,
		allowed_es: U4#[#],
		rng: sha3::State &) VOID
	{
		ASSERT(##allowed_es);
		lambda_n: [#Words]BigInt (NOINIT);
		ex: [#Words]BigInt ();
		FOR[find_n](i ::= 0;; i++)
		{
			Bits ::= Words*32;
			p ::= [#Words*32/2]generate_prime(rng, Bits/2);
			q ::= [#Words*32/2]generate_prime(rng, Bits/2);

			p.long_mul_into(q, &pub->N);
			pub->Accel := pub->N.accel_mod();

			p.Digits[0] ^= 1; q.Digits[0] ^= 1; // p-1, q-1
			lcm_unprotected_into(p, q, &lambda_n); // lambda_n := lcm(p-1, q-1)
			p.Digits[0] ^= 1; q.Digits[0] ^= 1; // restore p, q

			FOR(allowed_es)
			{
				ex.Digits[0] := pub->E := IT;
				IF(are_coprime(lambda_n, ex))
					BREAK [find_n];
			}
		}

		priv->D := invert(ex, lambda_n);
	}
}