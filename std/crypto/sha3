(/rl/)
::std::crypto::sha3 {
	keccak_function(state: U8[25] &) VOID
	{
		STATIC round_constants: U8[24]#(
			U8 0x0000000000000001, U8 0x0000000000008082, U8 0x800000000000808a,
			U8 0x8000000080008000, U8 0x000000000000808b, U8 0x0000000080000001,
			U8 0x8000000080008081, U8 0x8000000000008009, U8 0x000000000000008a,
			U8 0x0000000000000088, U8 0x0000000080008009, U8 0x000000008000000a,
			U8 0x000000008000808b, U8 0x800000000000008b, U8 0x8000000000008089,
			U8 0x8000000000008003, U8 0x8000000000008002, U8 0x8000000000000080,
			U8 0x000000000000800a, U8 0x800000008000000a, U8 0x8000000080008081,
			U8 0x8000000000008080, U8 0x0000000080000001, U8 0x8000000080008008
		);

		STATIC rotates: INT[24]#(
			1,  3,  6,  10, 15, 21, 28, 36, 45, 55, 2,  14,
			27, 41, 56, 8,  25, 43, 62, 18, 39, 61, 20, 44);

		STATIC indices: INT[24]#(
			10, 7,  11, 17, 18, 3, 5,  16, 8,  21, 24, 4,
			15, 23, 19, 13, 12, 2, 20, 14, 22, 9,  6,  1);

		FOR(round_constants)
		{
			bc: U8[5] (NOINIT);
			FOR(bc) // Theta
				IT := state[IOTA] ^ state[IOTA+5] ^ state[IOTA+10] ^ state[IOTA+15] ^ state[IOTA+20];

			FOR(5)
			{
				next ::= IOTA == 4 ?? 0 : IOTA+1;
				prev ::= IOTA == 0 ?? 4 : IOTA-1;
				t ::= bc[prev] ^ (bc[next] <<< 1);
				state[IOTA]    ^= t;
				state[IOTA+5]  ^= t;
				state[IOTA+10] ^= t;
				state[IOTA+15] ^= t;
				state[IOTA+20] ^= t;
			}

			{ // Rho-pi
				t ::= state[1];
				FOR(indices)
				{
					bc[0] := state[IT];
					state[IT] := (t <<< rotates[IOTA]);
					t := bc[0];
				}
			}

			FOR(i ::= 0; i < 25; i += 5) // Chi
			{
				bc[0] := state[i];
				bc[1] := state[i+1];
				bc[2] := state[i+2];
				bc[3] := state[i+3];
				bc[4] := state[i+4];

				state[i]   ^= bc[2] &~ bc[1];
				state[i+1] ^= bc[3] &~ bc[2];
				state[i+2] ^= bc[4] &~ bc[3];
				state[i+3] ^= bc[0] &~ bc[4];
				state[i+4] ^= bc[1] &~ bc[0];
			}

			state[0] ^= IT; // Iota
		}
	}

	State {
		Buffer: U8[25];
		Progress: U4;

		update(data: U1#[#]) VOID
		{
			p ::= Progress;
			FOR(data)
			{
				<U1 *>(Buffer!)[p++] ^= IT;
				IF(p > 135) { p := 0; keccak_function(Buffer); }
			}
			Progress := p;
		}

		sha_digest() U8[4] & {

			<U1 *>(Buffer!)[Progress] ^= 0x06;
			<U1 *>(Buffer!)[135] ^= 0x80;
			keccak_function(Buffer);
			= *<U8[4] *>(Buffer!);
		}

		shake_start() VOID {
			<U1 *>(Buffer!)[Progress] ^= 0x1F;
			<U1 *>(Buffer!)[135] ^= 0x80;
			Progress := 0;
			keccak_function(Buffer);
		}

		shake_output(out: U1[#]) VOID {
			p ::= Progress;
			FOR(out)
			{
				IF(p > 135) { p := 0; keccak_function(Buffer); }
				IT := <U1 *>(Buffer!)[p++];
			}
			Progress := p;
		}

		shake_output_xor(out: U1[#]) VOID {
			p ::= Progress;
			FOR(out)
			{
				IF(p > 135) { p := 0; keccak_function(Buffer); }
				IT ^= <U1 *>(Buffer!)[p++];
			}
			Progress := p;
		}
	}

	sha3_256(data: U1#[#]) U8[4] {
		s: State;
		s.update(data);
		= s.sha_digest();
	}

	shake_256(data: U1#[#], output: U1[#]) VOID
	{
		s: State;
		s.update(data);
		s.shake_start();
		s.shake_output(output);
	}

	shake_256_xor(data: U1#[#], output: U1[#]) VOID
	{
		s: State;
		s.update(data);
		s.shake_start();
		s.shake_output_xor(output);
	}
}