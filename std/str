(/rl/)

INCLUDE 'std/heap'
INCLUDE 'std/memory'

::std::str
{
	c(str: CHAR#[]) CHAR#[#] := str[FOR std::str::len(str)];
	ch(ch: CHAR#&) CHAR#[#] := (&ch)[FOR 1];
	[Enum] enum(e: Enum!) CHAR#[#] -- := str::c(<CHAR#*>(e)[]);

	order(lhs: CHAR#[#], rhs: CHAR#[#]) S1 {
		IF(s ::= ##lhs <> ##rhs) = s;

		FOR(##lhs)
			IF(s ::= lhs[IOTA] <> rhs[IOTA])
				= s;
		= 0;
	}

	eq(lhs: CHAR#[#], rhs: CHAR#[#]) BOOL {
		IF(##lhs != ##rhs) = FALSE;

		FOR(##lhs)
			IF(lhs[IOTA] != rhs[IOTA])
				= FALSE;

		= TRUE;
	}

	starts_with(lhs: CHAR#[#], find: CHAR#[#]) BOOL
	{
		IF(##find > ##lhs)
			= FALSE;
		= mem::[CHAR]cmp(lhs, find, ##find) == 0;
	}

	len(str: CHAR#[]) UM
	{
		IF(!str)
			= 0;
		i: UM := 0;
		WHILE(str[i]) ++i;
		= i;
	}

	CV {
		V: CHAR#[#];

		# THIS<>(rhs: THIS) S1 -- := str::order(V, rhs.V);
	}
}