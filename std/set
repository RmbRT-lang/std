(/rl/)

INCLUDE 'std/vector'

::std [Alloc; T] VecSetT
{
	PRIVATE Elems: [Alloc; T!]VecT;

	TYPE Location := UM;

	{};
	:reserve{cap: UM}: Elems := :reserve(cap);

	#? start() ? -- := Elems.start();
	#? end() ? -- := Elems.end();
	# empty() BOOL -- := Elems.empty();
	#? at_loc(l: Location) T#? * -- := l >= ##Elems ?? NULL : &Elems[:ok(l)];

	# ##THIS UM -- := ##Elems;

	# data() VOID #* -- := Elems.data();

	[V: TYPE]
	# has (v: V! #&) BOOL -- := find(v);

	[V: TYPE]
	#? find(v: V! #&) T! #? -OptRef
	{
		dummy: Location;
		= find_loc2(v, &dummy);
	}

	[V: TYPE]
	#? find_loc(v: V! #&) { T! #?-OptRef, Location }
	{
		loc: Location;
		ret ::= find_loc2(v, &loc);
		= (ret, loc);
	}

	[V: TYPE]
	#? find_loc2(
		v: V! #&,
		location: Location \
	) T! #? *
	{
		l: UM := 0;
		r: UM := ##Elems;

		i: UM := 0;
		WHILE(l < r)
		{
			i := (l + r)>>1;
			IF:!(sign ::= Elems[i] <> v)
			{
				*location := i;
				= &Elems[i];
			}

			IF(sign > 0)
				r := i;
			ELSE
				l := i+1;
		}

		*location := l;
		= NULL;
	}

	insert(v: T!) BOOL
	{
		loc: Location;
		IF(find_loc2(v, &loc))
			= FALSE;
		emplace_at(loc, &&v);
		= TRUE;
	}

	[A:TYPE]
	THIS+=(v: A!&&) BOOL --
		:= THIS.insert(<A!&&>(v));

	remove_at(
		position: Location) VOID --
	{
		Elems.erase(position);
	}

	[V: TYPE]
	remove(v: V! #&) BOOL
	{
		loc: Location;
		IF(find_loc2(v, &loc))
		{
			remove_at(loc);
			= TRUE;
		}
		= FALSE;
	}

	ensure(v: T!) T! &
	{
		loc: Location;
		IF(found ::= find_loc2(v, &loc))
			= *found;
		ELSE
			= emplace_at(loc, &&v);
	}

	THIS-=(v: T! #&) BOOL -- := THIS.remove(v);

	[V: TYPE]
	pop(v: V! #&, deleted: T! \) BOOL
	{
		loc: Location;
		IF(it ::= find_loc2(v, &loc))
		{
			*deleted := &&*it;
			remove_at(loc);
			= TRUE;
		}
		= FALSE;
	}


	[A...:TYPE]
	emplace_at(
		position: Location,
		a: A!&&...) T! &
	{
		Elems.emplace_at(position, <A!&&>(a)...);
		= Elems[position];
	}

	# THIS <> (rhs: THIS #&) S1 := Elems <> rhs.Elems;
}
::std [T] TYPE VecSet := [heap::Alloc; T!]VecSetT;