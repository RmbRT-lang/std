(/rl/)

INCLUDE 'std/io/stream'
INCLUDE 'std/io/streamutil'
INCLUDE 'std/io/format'
INCLUDE 'std/rng'

::std
{
	MASK CustomHashable { # hash(Hasher &) VOID; }

	Hash
	{
		TYPE Word := U8;
		Words: Word[1];

		# THIS==(rhs: THIS#&) BOOL -- := std::mem::eq(Words[], rhs.Words[], ##Words);
		# THIS!=(rhs: Hash#&) BOOL -- := !(THIS == rhs);

		# THIS<>(rhs: Hash#&) S1
		{
			FOR(i ::= 0; i < ##Words; i++)
				IF(unequal ::= Words[i] <> rhs.Words[i])
					= unequal;
			= 0;
		}

		# stream(into: io::OStream &) VOID
		{
			FOR(i ::= 0; i < ##Words; i++)
				io::format::hex(into, Words[i], 2 * SIZEOF(Word), !i);
		}

		# stream_noprefix(into: io::OStream &) VOID
		{
			FOR(i ::= 0; i < ##Words; i++)
				io::format::hex(into, Words[i], 2 * SIZEOF(Word), FALSE);
		}

		# hash(h: std::Hasher &) VOID
		{
			FOR(i ::= 0; i < ##Words; i++)
				h(Words[i]);
		}
	}

	[T...: TYPE]
	hash(v: T! &&...) Hash! --
	{
		h: Hasher;
		h(<T!&&>(v))...;
		= h.digest();
	}

	hash_str(str: CHAR#[#]) Hash --
	{
		h: Hasher;
		h(##str);
		h.bytes(<U1#*>(&*str)[FOR ##str]);
		= h.digest();
	}

	Hasher
	{
		UNION AccBufU {
			V8AndSpill: U8[65];
			V8: U8[64];
			V1: U1[512];
		}
		PRIVATE AccBuf: AccBufU;
		PRIVATE Current: U4;
		PRIVATE Digester: rng::V8StreamDigest;

		digest() Hash!
		{
			Digester.eat_chunk_end(AccBuf.V1[UNTIL Current & (##AccBuf.V1-1)]);
			Digester.eat_word(Current);
			//Digester.eat_word(0xf8c6942c18e01d15);
			h: Hash (NOINIT);
			h.Words[0] := Digester.digest_strong(); // weak digest is not enough when we have very short inputs that only vary in a few bits.
			= h;
		}

		bytes(v: U1#[#]) VOID --
		{
			FOR(<U8#*>(&*v)[FOR ##v >> 3])
				[U8]accum(IT);
			IF(rest ::= ##v & 7)
				[U8]accum_half(*<U8*>(&v[##v & ~7]), rest);
		}

		[T; T_...] THIS(v:T! #&, v_: T_!#&...) Hasher& --
		{
			_hash(v);
			_hash(v_)...;
			= THIS;
		}

		[T:TYPE] PRIVATE _hash(v: T!#&) VOID --
		{
			TYPE SWITCH STATIC(v)
			{
			BOOL:
				[U1]accum(<U1>(v));
			U1, S1, U2, S2, U4, S4, U8, S8, CHAR:
				[T]accum(v);
			DEFAULT:
			{
				IF#(h ::= <<<CustomHashable>>>(&v)) {
					h.hash(THIS);
				} ELSE {
					x: ?#& := v!;
					TYPE SWITCH STATIC(x)
					{
					BOOL:
						[U1]accum(<U1>(v));
					U1, S1, U2, S2, U4, S4, U8, S8, CHAR:
						[T]accum(x);
					DEFAULT:
						IF#(h ::= <<<CustomHashable>>>(&x))
							h.hash(THIS);
						ELSE
							THIS VISIT(v);
					}
				}
			}
			}
		}

		[T] PRIVATE accum(v: T!) VOID -- := [T]accum_half(v, SIZEOF(T));
		[T] PRIVATE accum_half(v: T!, size: U4) VOID --
		{
			<RAW &>(AccBuf.V1[Current & (##AccBuf.V1 -1)]) := v;
			c ::= Current;
			Current := c + size;
			IF(c >= SIZEOF(#AccBuf.V1) - size)
			{
				Digester.eat_words(AccBuf.V8);
				AccBuf.V8[0] := AccBuf.V8AndSpill[##AccBuf.V8];
			}
		}
	}
}