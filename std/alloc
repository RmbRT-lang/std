::std [Implementation] AllocPimpl {
	Impl: Implementation *;

	{...};

	alloc_raw_object(size: U4, alignment: U4) VOID \ --
		:= Impl->alloc_raw_object(size, alignment);
	alloc_raw_region(size: U4, alignment: U4) VOID \ --
		:= Impl->alloc_raw_region(size, alignment);
	free_raw_region(region: VOID #\, size: U4, alignment: U4) VOID --
		:= Impl->free_raw_region(region, size, alignment);
	free_raw_object(object: VOID #\, size: U4, alignment: U4) VOID --
		:= Impl->free_raw_object(object, size, alignment);
	resize_raw_region_in_place(
		region: VOID #\,
		size: U4,
		alignment: U4,
		newsize: U4
	) BOOL -- :=
		Impl->resize_raw_region_in_place(
			region,
			size,
			alignment,
			newsize);
	resize_raw_region(
		region: VOID #\,
		size: U4,
		alignment: U4,
		newsize: U4
	) VOID #\ -- :=
		Impl->resize_raw_region(
			region,
			size,
			alignment,
			newsize);
}
// TODO: implement our own allocator - see wasm project. We want to manage our own memory entirely, but it can wait for now.
::std [Implementation] Alloc
{
	Impl: Implementation;

	[T] clone(data: T![#]) T[#]
	{
		tmp ::= [T]alloc_array(##data);
		FOR(tmp) IT.{data[IOTA]};
		= tmp;
	}

	[T] alloc() T \ --
	{
		ptr ::= Impl.alloc_raw_object(SIZEOF(T), ALIGNOF(T));
		ASSERT(ptr != NULL);
		= <T \>(ptr);
	}
	[T] free(p: T! \) VOID --
		{ Impl.free_raw_object(p, SIZEOF(T), ALIGNOF(T)); }
	alloc_raw_object(size: U4, alignment: U4) VOID \ -- := Impl.alloc_raw_object(size, alignment);

	alloc_raw_region(size: U4, alignment: U4) VOID \ --
		:= Impl.alloc_raw_region(size, alignment);
	free_raw_region(region: VOID #\, size: U4, alignment: U4) VOID --
		{ Impl.free_raw_region(region, size, alignment); }
	resize_raw_region_in_place(
		region: VOID #\,
		size: U4,
		alignment: U4,
		newsize: U4
	) BOOL -- :=
		Impl.resize_raw_region_in_place(
			region,
			size,
			alignment,
			newsize);
	resize_raw_region(
		region: VOID #\,
		size: U4,
		alignment: U4,
		newsize: U4
	) VOID #\ -- :=
		Impl.resize_raw_region(
			region,
			size,
			alignment,
			newsize);

	[T]resize_array_in_place(array: T!#[#], newsize: U4) BOOL --
		:= resize_raw_region_in_place(
			&*array[],
			##array * SIZEOF(T),
			ALIGNOF(T),
			newsize * SIZEOF(T));

	[T]resize_array(array: T![#], newsize: U4) T[#] --
		:= <T*>(resize_raw_region(
			&*array[],
			##array * SIZEOF(T),
			ALIGNOF(T),
			newsize * SIZEOF(T)))[FOR newsize];

	// We actually don't want a generic allocator for everything.
	[T] alloc_array(count: U4) T[#] --
	{
		b ::= Impl.alloc_raw_region(count * SIZEOF(T), ALIGNOF(T));
		ASSERT(!count || b);
		= <T\>(b)[FOR count];
	}
	[T] alloc_array_aligned(count: U4, alignment: U4) T[#] --
	{
		b ::= Impl.alloc_raw_region(count * SIZEOF(T), alignment);
		ASSERT(!count || b);
		= <T\>(b)[FOR count];
	}

	[T] free_array(array: T![#]) VOID --
		{ Impl.free_raw_region(&*array[], SIZEOF(T) * ##array, ALIGNOF(T)); }

	[T; Args...] new(args: Args!&&...) T! *
	{
		// Do we want allocations to be able to fail?
		p ::= [T]alloc();
		TRY
		{
			p->{<Args!&&>(args)...};
			x ::= p;
			p := NULL;
			= x;
		}
		FINALLY IF(p)
			[T]free(p);
	}


	[T] delete_array(v: T![#]) VOID --
	{
		FOR(v) IT.~;
		THIS.[T]free_array(v);
	}

	[T] delete(ptr: T! \) VOID --
	{
		ptr->~;
		[T]free(ptr);
	}
}
::std [Implementation] TYPE PAlloc := Implementation-AllocPimpl-Alloc;