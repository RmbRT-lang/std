(/rl/)

::std [T]Opt
{
PRIVATE:
	UNION U
	{
	*	none;
	!?	a: T;
	}
	V: TAGGED [T!]Opt::U;
PUBLIC:

	{}--;
	{BARE}--();
	{NULL}--;

	DESTRUCTOR -- { IF(V) V->~; }

	[Args...:TYPE]
	:a{args: Args!&&...} --: V := :a(<Args!&&>(args)...);

	[Args...:TYPE]
	:if{cond: BOOL, args: Args!&&...} --:
		V(NOINIT)
	{
		V.(0).{<ENUM U>(cond)};
		IF(cond)
			V!.{<Args!&&>(args)...};
	}

	{#&cpy}: V(NOINIT)
	{
		IF(cpy.V)
			V.{:a(*cpy.V)};
		ELSE
			V.{:none};
	}
	{&&rhs}: V(NOINIT)
	{
		IF(rhs.V)
			V.{:a(&&*rhs.V)};
		ELSE
			V.(0).{:none};
		rhs.{NULL};
	}

	[Args...: TYPE]
	ensure(args: Args!&&...) T!& --
	{
		IF(!V) V.{ :a(<Args!&&>(args)...) };
		= *THIS;
	}

	# <BOOL> -- := V;

	#? THIS! T! #?& -- := *THIS;
	#? *THIS T! #?& --
	{
		ASSERT(V);
		= *V;
	}

	#? ok() T! #? -- := *V;
	#? ptr() T #? * := V ?? &*V : NULL;
	
	# THIS<>(rhs: THIS #&) S1
	{
		IF(!THIS) = rhs ?? -1 : 0;
		IF(!rhs) = 1;

		= *THIS <> *rhs;
	}
}