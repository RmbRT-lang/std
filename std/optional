INCLUDE 'std/io/streamutil'
INCLUDE 'std/hashable'
INCLUDE 'std/hash'

::std [T]Opt -> std::CustomHashable0Cost
{
PRIVATE:
	UNION U
	{
	*	none;
	!?	a: T;
	}
	V: TAGGED U;
PUBLIC:

	{}--;
	{BARE}--();
	{NULL}--;

	[Args...:TYPE]
	:a{args: Args!&&...} --: V := :a(<Args!&&>(args)...);

	[Args...:TYPE]
	:if{cond: BOOL, args: Args!&&...} --:
		V(NOINIT)
	{
		V.(0).{<ENUM U>(cond)};
		IF(cond)
			V!.{<Args!&&>(args)...};
	}

	{#&};
	{&&rhs}: V(NOINIT)
	{
		V.{&&rhs.V};
		rhs.{NULL};
	}

	[Args...: TYPE]
	ensure(args: Args!&&...) T!& --
	{
		IF(!V) V.{ :a(<Args!&&>(args)...) };
		= *THIS;
	}

	# <BOOL> -- := V;

	#? THIS! T! #?& -- := *THIS;
	#? *THIS T! #?& --
	{
		ASSERT(V);
		= *V;
	}

	#? ok() T! #? -- := *V;
	#? ptr() T #? * := V ?? &*V : NULL;
	
	# THIS<>(rhs: THIS #&) S1
	{
		IF(!THIS) = rhs ?? -1 : 0;
		IF(!rhs) = 1;

		= *THIS <> *rhs;
	}

	# hash(h: std::Hasher &) VOID
	{
		IF(!THIS) h(FALSE);
		ELSE h(TRUE, *THIS);
	}
}