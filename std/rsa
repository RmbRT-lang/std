	[#Words] BigInt {
		Digits: U4[Words];

		# first1pos() U2 --
		{
			FOR(Digits)
				IF(IT)
					= 32 * IOTA + FIRST1POS IT;
			= 32 * ##Digits;
		}

		# last1pos() U2 --
		{
			FOR(Digits; --)
				IF(IT)
					= 32 * IOTA + LAST1POS IT;

			= 32 * ##Digits;
		}

		# shr_into(result: THIS &, amount: U2) VOID
		{
			// Use 32-bit words to make shifting easier (by using 64-bit shifts to compute the final value of each 32-bit word).
			src_32 ::= Digits!;
			dst_32 ::= result.Digits!;

			shift_digits ::= amount >> 5;
			shift_bits ::= amount & 31;

			ASSERT(amount < 32 * Words);

			write ::= result.Digits[];

			// Zero high words.
			FOR(dst_32[FROM Words - shift_digits]) IT := 0;

			// 64-bit shift trick...
			FOR(shift_digits-1)
				*write++ := *<U8 #*>(&src_32[shift_digits + IOTA]) >> shift_bits;

			// highest word.
			*write := src_32[Words-1] >> shift_bits;
		}

		THIS >>= (amount: U2) VOID
		{ // TODO: UGLY
			x ::= THIS;
			x.shr_into(THIS, amount);
		}

		THIS -= (rhs: THIS #&) VOID
		{
			borrow: S8;
			FOR(Digits)
			{ // TODO: add sub with borrow intrinsic.
				result: S8 := (S8 IT - S8 rhs.Digits[IOTA]) + borrow;
				IT := result;
				borrow := result >> 32;
			}

			ASSERT(!borrow); // underflow.
		}

		THIS <<= (amount: U2) VOID
		{
			digits_32 ::= Digits!;

			shift_digits ::= amount >> 5;
			shift_bits ::= amount & 31;

			cut_digits ::= Words - shift_digits;
			intact_digits ::= Words - (cut_digits + shift_digits);

			ASSERT(amount < 64 * Words);

			count_32# ::= Words;

			FOR(i ::= count_32; --i > shift_digits;)
			{
				sh ::= (*<U8 #*>(&digits_32[(i-1) - shift_digits]) << shift_bits);
				digits_32[i] := sh >> 32;
			}

			digits_32[shift_digits] := digits_32[0] << shift_bits;

			FOR(shift_digits)
				digits_32[IOTA] := 0;
		}

		# THIS <> (rhs: THIS #&) S1
		{
			FOR(Digits; --)
				IF(s ::= IT <> rhs.Digits[IOTA])
					= s;
			= 0;
		}

		# THIS == (rhs: THIS #&) BOOL
		{
			FOR(Digits; --)
				IF(IT != rhs.Digits[IOTA])
					= FALSE;
			= TRUE;
		}

		# THIS >= (rhs: THIS #&) BOOL {
			FOR(Digits; --)
				IF(IT < rhs.Digits[IOTA])
					= FALSE;
			= TRUE;
		}

		long_mul_into(rhs: THIS #&, result: [#2*Words]BigInt \) VOID
		{
			*result := ();

			FOR(Digits)
			{
				outer ::= IOTA;
				d ::= IT;

				c: U8;
				w ::= &result->Digits[outer];
				FOR(rhs.Digits)
				{
					product: U8 := d * IT;

					sum: U8 := (*w + product) + c;
					*w++ := sum;
					c := sum >> 32;
				}
			}
		}

		mixed_mod_assign(modulo: [#Words/2]BigInt #&) VOID
		{
			// Shift-and-subtract, by starting with maxed-out modulo, halving the modulo every time.
			// Assumption: modulo has msb 1 / no leading zeroes.


			// mod_ext := modulo:0 (high:low), MSB should be 1.
			mod_ext: THIS (NOINIT);
			FOR(mod_ext.Digits[FROM Words/2]) IT := modulo.Digits[IOTA];
			FOR(mod_ext.Digits[UNTIL Words/2])  IT := 0;

			ASSERT(mod_ext.last1pos() == Words * 32);

			// CAUTION TODO CHECK: uncertain whether we need one more iteration or one less or something!
			FOR((Words/2) * 32)
			{
				THIS.subtract_assign_if(mod_ext, THIS >= mod_ext);
				mod_ext >>= 1;
			}

			THIS.subtract_assign_if(mod_ext, THIS >= mod_ext);
		}

		mul_mod_assign(rhs: THIS#&, modulo: THIS #&) VOID
		{
			tmp: [#2*Words]BigInt (NOINIT);
			THIS.long_mul_into(rhs, &tmp);
			tmp.mixed_mod_assign(modulo);

			FOR(Digits) IT := tmp.Digits[IOTA];
		}

		square_mod_assign(rhs: THIS#&, modulo: THIS #&) VOID --
		{
			mul_mod_assign(rhs, modulo);
		}

		# pow_mod_into(power: THIS #&, modulo: THIS #&, rem: THIS \) VOID
		{
			accum: THIS; accum.Digits[0] := 1;

			base ::= THIS;
			FOR(power.bits())
			{
				// NOTE: in all public-facing (i.e. side-channel relevant) operations, exponents are publicly known, therefore, we do not need to be branchless here.
				IF(IT) accum.mul_mod_assign(base, modulo);

				base.square_mod_assign(modulo);
			}
		}
	}

	[#Words] are_coprime(
		a: [#Words]BigInt #&,
		b: [#Words]BigInt #&) BOOL
	{
		tmp_a: [#Words]BigInt (NOINIT);
		tmp_b: [#Words]BigInt (NOINIT);

		f1p_a ::= a.first1pos();
		f1p_b ::= b.first1pos();

		IF(f1p_a != 0 && f1p_b != 0) = FALSE;


		// Remove all trailing zeroes.
		a.shr_into(tmp_a, f1p_a);
		b.shr_into(tmp_b, f1p_b);

		l1p_a ::= tmp_a.last1pos();
		t1p_b ::= tmp_b.last1pos();

		WHILE(sign ::= (tmp_a <> tmp_b))
		{
			lesser ::= sign < 0 ?? &tmp_a : &tmp_b;
			greater ::= sign < 0 ?? &tmp_b : &tmp_a;

			*greater -= *lesser;
			*greater >>= greater->first1pos();
		}

		= tmp_a.last1pos() == 0; // means GCD = 1.
	}

	[#Words]
	rabin_miller_prime_test(
		n: [#Words]BigInt &,
		sample_start: U8,
		sample_count: U4) BOOL
	{
		IF!(n.Digits[0] & 1) DIE "candidate must be odd";

		// Quick GCD check: 
		IF#(Words == 32)
		{
			IF!(are_coprime(n, *<[#32]BigInt #*>(&primes_2k))) = FALSE;
		}
		ELSE
		{
			IF!(are_coprime(n, *<[#64]BigInt #*>(&primes_4k))) = FALSE;
		}

		n.Digits[0] ^= 1; // n-1 (since n is already odd)
		s ::= n.first1pos(); // CTZ(n-1)

		d: [#Words]BigInt (NOINIT);
		n.shr_into(d, s);

		// restore n.
		n.Digits[0] ^= 1;

		rem: [#Words]BigInt (NOINIT);
		sample_x: [#Words]BigInt;

		FOR(sample_count)
		{
			sample_x.digits[0] := sample_start + IOTA;

			// sample^d % n
			sample_x.pow_mod_into(d, n, &rem);

			n.Digits[0] ^= 1; // restore n-1
			is_pred ::= rem == n;
			n.Digits[0] ^= 1; // restore n

			IF(rem.last1pos() != 0 && !is_pred)
				= FALSE;
		}

		IF(s)
			DO(r: U4 := 1)
			{
				FOR(sample_count)
				{
					sample_x.digits[0] := sample_start + IOTA;

					// sample^d % n
					sample_x.pow_mod_into(d, n, &rem);

					n.Digits[0] ^= 1; // restore n-1
					is_pred ::= rem == n;
					n.Digits[0] ^= 1; // restore n

					IF!(is_pred) = FALSE;
				}
			} FOR(r++ == s; d <<= 1)

		= TRUE;
	}
