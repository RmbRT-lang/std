(/rl/)
INCLUDE 'std/map'
INCLUDE 'std/hash'

/// kCachedHashTiers: how many steps of the binary search to cache (exp2 hashes are cached).
::std [Alloc; Cmp; VHot; VCold; kCachedHashTiers: NUMBER] HashBucketT
{
	PRIVATE Values: VCold[];
	PRIVATE Hashes: {Hash, VHot}[];
	PRIVATE Count: U4;

	// for fast lookups without pointer chasing.
	PRIVATE HashCache: {Hash, VHot}[(1<<kCachedHashTiers) - 1];

	[kN:NUMBER] # multi_lookup(hashes: Hash[kN] #&, pointers: {VHot *, VCold *}[kN] &) VOID --
	{
		idxs: U4[kN] := ~0; // The found indices.

		// If we have more items than cache entries, the cache contains the first few steps of the binary search.
		IF(Count > kCachedHashTiers)
		{
			lefts: U4[kN] (NOINIT);
			rights: U4[kN] (NOINIT);

			FOR(lefts) IT.{0};
			FOR(rights) IT.{##Count};

			FOR(HashCache)
			{
				hash ::= IT;
				hash_index ::= IOTA * Count >> kCachedHashTiers;
				FOR(kN)
				{
					diff: S8 := hash - hashes[IOTA].(0);

					lefts[IOTA] := (diff < 0) ?? hash_index+1 : lefts[IOTA];
					rights[IOTA] := (diff > 0) ?? hash_index : rights[IOTA];
					idxs[IOTA] := (diff == 0) ?? hash_index : idxs[IOTA];
				}
			}
		} ELSE {
			// Otherwise, the cache directly contains the hashes of the elements, and we just do a linear search.
			FOR(HashCache[FOR Count])
			{
				hash ::= IT;
				hash_index ::= IOTA;

				FOR(kN)
				{
					diff: S8 := HashCache[idxs[IOTA]] - hash;
					lefts[IOTA] := (diff < 0) ?? hash_index+1 : lefts[IOTA];
					rights[IOTA] := (diff > 0) ?? hash_index : rights[IOTA];
					idxs[IOTA] := (diff == 0) ?? hash_index : idxs[IOTA];
				}
			}
		}

		FOR(Pointers)
		{
			IT.(0) := idxs[IOTA] ?? &Hashes[IOTA].(1) : NULL;
			IT.(1) := idxs[IOTA] ?? &Values[IOTA] : NULL;
		}
	}

	[Value: TYPE]
	insert(k: K! #&, v: Value!&&) BOOL := Map.insert(hash(k), <Value!&&>(v));

	[Value: TYPE]
	insert_h(k: Hash #&, v: Value!&&) BOOL := Map.insert(k, <Value!&&>(v));

	remove(k: K! #&) BOOL -- := remove_h(hash(k));
	pop(k: K! #&, deleted: V! \) BOOL := pop_h(hash(k), deleted);

	remove_h(k: Hash #&) BOOL -- := Map.remove(k);
	pop_h(k: Hash #&, deleted: V! \) BOOL -- := Map.pop(k, deleted);

	#? start() ? -- := Map.start();
	#? end() ? -- := Map.end();
	# empty() BOOL -- := Map.empty();
}
