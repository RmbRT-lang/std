(/rl/)

::std::io::format
{
	HexNumBuffer { Buf: CHAR[19]; Len: U1; # <CHAR#[#]> -- := Buf[FOR Len]; }
	[T] hex_into(
		o: CHAR[#],
		n: T! #&,
		minDigits: U1,
		prefix: BOOL
	) U1
	{
		v: UM := n;

		neg: BOOL;
		IF(n < <T>(0))
		{
			neg := TRUE;
			v := -v;
		}

		buffer: CHAR[32] (NOINIT);
		buf ::= buffer[#];

		len ::= 0;
		IF(neg)
			buf[len++] := '-';

		IF(prefix) {
			buf[len++] := '0';
			buf[len++] := 'x';
		}
		printed ::= FALSE;
		FOR(bit ::= 2*SIZEOF(T); bit--;)
		{
			nibble: U1# := (v>>(bit<<2)) & 0xf;
			IF(nibble || printed || bit < minDigits)
			{
				buf[len++] := "0123456789abcdef"[nibble];
				printed := TRUE;
			}
		}

		IF(!printed)
			buf[len++] := '0';

		write ::= buf[FOR len];
		FOR(write) o[IOTA] := IT;
		= len;
	}

	[T] hex(n: T! #&) HexNumBuffer -- := [T!]hex_x(n, 0, TRUE);
	[T] hex_x(n: T!#&, minDigits: U1, prefix: BOOL) HexNumBuffer
	{
		ret: HexNumBuffer (NOINIT);
		ret.Len := [T!]hex_into(ret.Buf, n, minDigits, prefix);
		= ret;
	}

	DecNumBuffer { Buf: CHAR[18]; Start: U1; # <CHAR#[#]> -- := Buf[FROM Start]; }


	UNION Format {
	!	Pad0: U1;
		Pad: U1;
	}

	[T] dec_into(o: CHAR[#], n: T! #&, format: TAGGED Format) U1
	{
		minDigits ::= format.(1).Pad;
		padChar: CHAR := format.(0) == :Pad0 ?? '0' : ' ';

		v: U8 := n;
		neg: BOOL;
		IF(n < <T>(0))
		{
			neg := TRUE;
			v := -v;
		}
		IF(minDigits >= ##o)
			minDigits := ##o;

		i ::= ##o-1;
		DO()
		{
			d ::= v % 10;
			v := v / 10;

			o[i] := '0'+d;
		} FOR(i && v; i--)
		digits ::= ##o - i;
		WHILE(digits < minDigits)
		{
			o[--i] := padChar;
			++digits;
		}

		IF(v || (!i && neg))
			= ##o;

		IF(neg)
			o[--i] := '-';

		= i;
	}

	[T] dec(n: T! #&) DecNumBuffer -- := [T!]dec_x(n, 1);
	[T] dec_x(n: T! #&, format: TAGGED Format) DecNumBuffer {
		ret: DecNumBuffer (NOINIT);
		ret.Start := [T!]dec_into(ret.Buf, n, format);
		= ret;
	}
}