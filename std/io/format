(/rl/)

INCLUDE 'std/io/stream'

::std::io::format
{
	[T:TYPE] hex(
		o: OStream &,
		n: T! #&,
		minDigits: U1,
		prefix: BOOL
	) VOID
	{
		v: UM := n;

		neg: BOOL;
		IF(n < <T>(0))
		{
			neg := TRUE;
			IF(~n) // If -max, ignore value.
				v := -n;
		}

		buffer: CHAR[32] (NOINIT);
		buf ::= buffer[#];

		len ::= 0;
		IF(neg)
			buf[len++] := '-';

		IF(prefix) {
			buf[len++] := '0';
			buf[len++] := 'x';
		}
		printed ::= FALSE;
		FOR(bit ::= 2*SIZEOF(T); bit--;)
		{
			nibble: U1# := (v>>(bit<<2)) & 0xf;
			IF(nibble || printed || bit < minDigits)
			{
				buf[len++] := "0123456789abcdef"[nibble];
				printed := TRUE;
			}
		}

		IF(!printed)
			buf[len++] := '0';

		write ::= buf[FOR len];
		o.write(&*write[], ##write);
	}

	[T:TYPE] dec(o: OStream &, n: T! #&, minDigits: U1) VOID
	{
		v: UM := n;
		neg: BOOL;
		IF(n < <T>(0))
		{
			neg := TRUE;
			IF(~n)
				v := -n;
		}
		IF(minDigits >= 30)
			minDigits := 30;

		buf: CHAR[32] (NOINIT);
		i ::= ##buf-1;
		DO()
		{
			d ::= v % 10;
			v := v / 10;

			buf[i] := '0'+d;
		} FOR(v; i--)
		digits ::= ##buf - i;
		WHILE(digits < minDigits)
		{
			buf[--i] := '0';
			++digits;
		}

		IF(neg)
			buf[--i] := '-';

		write ::= buf[FROM i];
		o.write(&*write[], ##write);
	}
}