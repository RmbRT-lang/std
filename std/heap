(/rl/)

INCLUDE 'std/range'
INCLUDE 'std/alloc'

::std::heap
{
	AllocImpl {
		STATIC alloc_raw_object(bytes: U4, align: U4) VOID * --
			:= detail::libc::malloc(bytes);
		STATIC free_raw_object(ptr: VOID *, size: U4, align: U4) VOID --
			{ detail::libc::free(ptr); }
		STATIC free_raw_region(ptr: VOID #\, size: U4, align: U4) VOID --
			{ detail::libc::free(ptr); }
		STATIC alloc_raw_region(bytes: U4, align: U4) VOID * --
			:= detail::libc::malloc(bytes);
		STATIC resize_raw_region_in_place(VOID #\, U4, U4, U4) BOOL --
			:= FALSE;
	}

	TYPE Alloc := std::[AllocImpl]Alloc;
	alloc: Alloc;
}

::std::detail::libc
{
	EXTERN malloc(UM) VOID *;
	EXTERN free(VOID #\) VOID;
	EXTERN realloc(VOID #\, UM) VOID;
}